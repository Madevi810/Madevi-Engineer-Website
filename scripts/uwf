#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UWF_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//; s/-$//'
}

copy_template() {
  local target="$1"
  mkdir -p "$target"
  for item in AGENTS.md FOUNDATION_MANIFEST.yaml Foundation Project-Implementasi templates docs plugins skills README.md; do
    cp -R "$UWF_HOME/$item" "$target/"
  done
  rm -f "$target/README.md"
  cat >"$target/README.md" <<'EOF'
# UWF Workspace

This workspace was created from Universal Web Foundation.

1. Open this folder in an AI coding environment.
2. Ask the AI to read AGENTS.md and FOUNDATION_MANIFEST.yaml.
3. Start Foundation discovery; do not add application code before approval.
EOF
}

init_project() {
  local name="${1:-}"
  if [[ -z "$name" ]]; then read -r -p "Nama web/proyek: " name; fi
  [[ -n "$name" ]] || { printf 'Nama proyek wajib diisi.\n' >&2; exit 1; }
  local slug target escaped
  slug="$(slugify "$name")"
  [[ -n "$slug" ]] || { printf 'Nama proyek tidak valid.\n' >&2; exit 1; }
  target="$PWD/$slug"
  [[ ! -e "$target" ]] || { printf 'Folder sudah ada: %s\n' "$target" >&2; exit 1; }
  copy_template "$target"
  escaped="$(printf '%s' "$name" | sed 's/[&|]/\\&/g')"
  sed -i "s|name: Unnamed Web Project|name: $escaped|" "$target/FOUNDATION_MANIFEST.yaml"
  sed -i "s|slug: unnamed-web-project|slug: $slug|" "$target/FOUNDATION_MANIFEST.yaml"
  printf '\nWorkspace dibuat: %s\nMasuk dengan: cd %q\nLalu jalankan: uwf status\n' "$target" "$slug"
}

show_status() {
  local manifest="$PWD/FOUNDATION_MANIFEST.yaml"
  [[ -f "$manifest" ]] || { printf 'FOUNDATION_MANIFEST.yaml tidak ditemukan di folder ini.\n' >&2; exit 1; }
  printf 'UWF status for %s\n\n' "$PWD"
  grep -E '^(  (name|mode|lifecycle_status|experience_level|guidance_mode|current_stage|current_stage_name|status|implementation_gate|implementation_status|enabled|runner|budget_limit):)' "$manifest" || true
}

approve_implementation() {
  local project=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="${2:-}"; shift 2 ;;
      *) printf 'Argumen tidak dikenal: %s\n' "$1" >&2; exit 1 ;;
    esac
  done
  [[ -n "$project" ]] || { printf 'Gunakan: uwf approve implementation --project "Nama Web"\n' >&2; exit 1; }
  [[ -f FOUNDATION_MANIFEST.yaml ]] || { printf 'Jalankan perintah ini dari root workspace UWF.\n' >&2; exit 1; }
  [[ -d Project-Implementasi ]] || { printf 'Project-Implementasi tidak ditemukan; mungkin sudah diaktifkan.\n' >&2; exit 1; }
  "$UWF_HOME/scripts/validate-foundation.sh" "$PWD" --gate || {
    printf 'Implementation approval blocked. Complete the Foundation issues above first.\n' >&2
    exit 1
  }
  local stamp
  stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  sed -i 's/implementation_gate: .*/implementation_gate: APPROVED/' FOUNDATION_MANIFEST.yaml
  sed -i 's/implementation_status: .*/implementation_status: APPROVED/' FOUNDATION_MANIFEST.yaml
  sed -i "s/last_developer_approval: .*/last_developer_approval: $stamp/" FOUNDATION_MANIFEST.yaml
  sed -i "s/last_updated: .*/last_updated: $stamp/" FOUNDATION_MANIFEST.yaml
  "$UWF_HOME/scripts/create-project.sh" "$project"
}

show_help() {
  cat <<'EOF'
Universal Web Foundation

Usage:
  uwf                         Start the interactive menu
  uwf init [nama-web]         Create a new UWF workspace
  uwf status                  Show current workspace status
  uwf validate                Validate the current Foundation workspace
  uwf approve implementation --project "Nama Web"
                              Approve and create Project-Nama-Web
EOF
}

interactive() {
  printf '%s\n' 'Universal Web Foundation'
  printf '%s\n' '1. Buat proyek baru'
  printf '%s\n' '2. Lihat status Foundation di folder ini'
  printf '%s\n' '3. Validasi Foundation di folder ini'
  printf '%s\n' '4. Keluar'
  read -r -p 'Pilih: ' choice
  case "$choice" in
    1) init_project ;;
    2) show_status ;;
    3) "$UWF_HOME/scripts/validate-foundation.sh" "$PWD" ;;
    4) exit 0 ;;
    *) printf 'Pilihan tidak dikenal.\n' >&2; exit 1 ;;
  esac
}

case "${1:-}" in
  "") interactive ;;
  init) shift; init_project "${1:-}" ;;
  status) show_status ;;
  validate) "$UWF_HOME/scripts/validate-foundation.sh" "$PWD" ;;
  approve)
    shift
    [[ "${1:-}" == "implementation" ]] || { show_help; exit 1; }
    shift
    approve_implementation "$@"
    ;;
  help|-h|--help) show_help ;;
  *) show_help; exit 1 ;;
esac
