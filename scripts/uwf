#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  LINK_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" = /* ]] || SCRIPT_PATH="$LINK_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
UWF_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//; s/-$//'
}

copy_template() {
  local target="$1"
  mkdir -p "$target"
  for item in AGENTS.md FOUNDATION_MANIFEST.yaml Foundation Project-Implementasi templates docs plugins skills README.md; do
    cp -R "$UWF_HOME/$item" "$target/"
  done
  rm -f "$target/README.md"
  cat >"$target/README.md" <<'EOF'
# UWF Workspace

This workspace was created from Universal Web Foundation.

1. Open this folder in an AI coding environment.
2. Ask the AI to read AGENTS.md and FOUNDATION_MANIFEST.yaml.
3. Start Foundation discovery; do not add application code before approval.
EOF
}

starter_pack_source() {
  case "$1" in
    content-platform|marketplace|dashboard|hybrid-platform) printf '%s/templates/starter-packs/%s.md\n' "$UWF_HOME" "$1" ;;
    *) printf 'Starter pack tidak dikenal: %s\n' "$1" >&2; return 1 ;;
  esac
}

apply_starter_pack() {
  local target="$1" id="$2" source
  source="$(starter_pack_source "$id")" || return 1
  mkdir -p "$target/Foundation/04-Product-Modules"
  cp "$source" "$target/Foundation/04-Product-Modules/Starter-Pack-$id.md"
}

init_project() {
  local name="" template_id=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --template)
        [[ $# -ge 2 ]] || { printf 'Gunakan: uwf init nama-web --template template-id\n' >&2; exit 1; }
        template_id="$2"
        shift 2
        ;;
      *)
        [[ -z "$name" ]] || { printf 'Argumen tidak dikenal: %s\n' "$1" >&2; exit 1; }
        name="$1"
        shift
        ;;
    esac
  done
  if [[ -z "$name" ]]; then read -r -p "Nama web/proyek: " name; fi
  [[ -n "$name" ]] || { printf 'Nama proyek wajib diisi.\n' >&2; exit 1; }
  local slug target escaped
  slug="$(slugify "$name")"
  [[ -n "$slug" ]] || { printf 'Nama proyek tidak valid.\n' >&2; exit 1; }
  target="$PWD/$slug"
  [[ ! -e "$target" ]] || { printf 'Folder sudah ada: %s\n' "$target" >&2; exit 1; }
  copy_template "$target"
  if [[ -n "$template_id" ]]; then
    apply_starter_pack "$target" "$template_id"
  fi
  escaped="$(printf '%s' "$name" | sed 's/[&|]/\\&/g')"
  sed -i "s|name: Unnamed Web Project|name: $escaped|" "$target/FOUNDATION_MANIFEST.yaml"
  sed -i "s|slug: unnamed-web-project|slug: $slug|" "$target/FOUNDATION_MANIFEST.yaml"
  printf '\nWorkspace dibuat: %s\nMasuk dengan: cd %q\nLalu jalankan: uwf status\n' "$target" "$slug"
  [[ -z "$template_id" ]] || printf 'Starter pack ditambahkan: %s\n' "$template_id"
}

show_status() {
  local manifest="$PWD/FOUNDATION_MANIFEST.yaml"
  [[ -f "$manifest" ]] || { printf 'FOUNDATION_MANIFEST.yaml tidak ditemukan di folder ini.\n' >&2; exit 1; }
  if [[ "${1:-}" == "--json" ]]; then
    show_status_json "$manifest"
    return
  fi
  printf 'UWF status for %s\n\n' "$PWD"
  printf '  name: %s\n' "$(section_value project name "$manifest")"
  printf '  mode: %s\n' "$(section_value project mode "$manifest")"
  printf '  lifecycle_status: %s\n' "$(section_value project lifecycle_status "$manifest")"
  printf '  experience_level: %s\n' "$(section_value developer experience_level "$manifest")"
  printf '  guidance_mode: %s\n' "$(section_value developer guidance_mode "$manifest")"
  printf '  current_stage: %s\n' "$(section_value foundation current_stage "$manifest")"
  printf '  current_stage_name: %s\n' "$(section_value foundation current_stage_name "$manifest")"
  printf '  foundation_status: %s\n' "$(section_value foundation status "$manifest")"
  printf '  implementation_gate: %s\n' "$(section_value foundation implementation_gate "$manifest")"
  printf '  implementation_status: %s\n' "$(section_value foundation implementation_status "$manifest")"
  printf '  change_status: %s\n' "$(section_value change_management change_status "$manifest")"
  printf '  active_reference: %s\n' "$(section_value ui_ux active_reference "$manifest")"
  printf '  reference_status: %s\n' "$(section_value ui_ux reference_status "$manifest")"
  printf '  simulation_status: %s\n' "$(section_value ui_ux simulation_status "$manifest")"
  printf '  history_status: %s\n' "$(section_value implementation_history status "$manifest")"
  printf '  automation_enabled: %s\n' "$(section_value automation enabled "$manifest")"
}

section_value() {
  local section="$1" key="$2" manifest="$3"
  awk -v section="$section" -v key="$key" '
    $0 == section ":" { active=1; next }
    active && /^[^[:space:]]/ { exit }
    active && $0 ~ "^  " key ":" {
      sub("^  " key ":[[:space:]]*", "")
      sub("[[:space:]]*#.*$", "")
      print
      exit
    }
  ' "$manifest"
}

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

show_status_json() {
  local manifest="$1"
  printf '{"schema":"uwf-status/v1","workspace":"%s","project":{"name":"%s","slug":"%s","mode":"%s","lifecycle_status":"%s"},"developer":{"experience_level":"%s","guidance_mode":"%s"},"foundation":{"current_stage":"%s","current_stage_name":"%s","status":"%s","implementation_gate":"%s","implementation_status":"%s"},"change_management":{"active_request":"%s","status":"%s","last_impact_level":"%s"},"ui_ux":{"active_reference":"%s","reference_status":"%s","creative_brief_status":"%s","simulation_status":"%s","preferred_simulation":"%s"},"implementation_history":{"status":"%s","current_release":"%s"},"automation":{"enabled":"%s"}}\n' \
    "$(json_escape "$PWD")" \
    "$(json_escape "$(section_value project name "$manifest")")" \
    "$(json_escape "$(section_value project slug "$manifest")")" \
    "$(json_escape "$(section_value project mode "$manifest")")" \
    "$(json_escape "$(section_value project lifecycle_status "$manifest")")" \
    "$(json_escape "$(section_value developer experience_level "$manifest")")" \
    "$(json_escape "$(section_value developer guidance_mode "$manifest")")" \
    "$(json_escape "$(section_value foundation current_stage "$manifest")")" \
    "$(json_escape "$(section_value foundation current_stage_name "$manifest")")" \
    "$(json_escape "$(section_value foundation status "$manifest")")" \
    "$(json_escape "$(section_value foundation implementation_gate "$manifest")")" \
    "$(json_escape "$(section_value foundation implementation_status "$manifest")")" \
    "$(json_escape "$(section_value change_management active_request "$manifest")")" \
    "$(json_escape "$(section_value change_management change_status "$manifest")")" \
    "$(json_escape "$(section_value change_management last_impact_level "$manifest")")" \
    "$(json_escape "$(section_value ui_ux active_reference "$manifest")")" \
    "$(json_escape "$(section_value ui_ux reference_status "$manifest")")" \
    "$(json_escape "$(section_value ui_ux creative_brief_status "$manifest")")" \
    "$(json_escape "$(section_value ui_ux simulation_status "$manifest")")" \
    "$(json_escape "$(section_value ui_ux preferred_simulation "$manifest")")" \
    "$(json_escape "$(section_value implementation_history status "$manifest")")" \
    "$(json_escape "$(section_value implementation_history current_release "$manifest")")" \
    "$(json_escape "$(section_value automation enabled "$manifest")")"
}

show_next() {
  local manifest="$PWD/FOUNDATION_MANIFEST.yaml"
  [[ -f "$manifest" ]] || { printf 'FOUNDATION_MANIFEST.yaml tidak ditemukan di folder ini.\n' >&2; exit 1; }
  local stage
  stage="$(section_value foundation current_stage_name "$manifest")"
  [[ -n "$stage" ]] || stage="belum dipilih"
  if [[ "${1:-}" == "--json" ]]; then
    printf '{"schema":"uwf-next/v1","current_stage":"%s","next_action":"read_question_bank_answer_active_stage_then_validate"}\n' "$(json_escape "$stage")"
    return
  fi
  printf 'Tahap aktif: %s\n' "$stage"
  printf 'Langkah berikutnya: baca Foundation/13-Question-Bank, jawab pertanyaan tahap aktif, lalu jalankan uwf validate.\n'
}

show_context() {
  [[ -f FOUNDATION_MANIFEST.yaml ]] || { printf 'Jalankan dari root workspace UWF.\n' >&2; exit 1; }
  if [[ "${1:-}" == "--json" ]]; then
    printf '{"schema":"uwf-agent-context/v1","read_order":["FOUNDATION_MANIFEST.yaml","Foundation/00-Control/Open-Questions.md","Foundation/00-Control/Decision-Log.md","active Foundation stage","current status report"],"commands":{"status":"uwf status --json","next":"uwf next --json","validate":"uwf validate --json"},"guardrail":"Do not implement application code until the developer explicitly approves the implementation gate."}\n'
    return
  fi
  printf '%s\n' 'UWF agent context'
  printf '%s\n' '1. Read FOUNDATION_MANIFEST.yaml.'
  printf '%s\n' '2. Read Foundation/00-Control/Open-Questions.md.'
  printf '%s\n' '3. Read Foundation/00-Control/Decision-Log.md.'
  printf '%s\n' '4. Read the active Foundation stage and current status report.'
  printf '%s\n' '5. Run: uwf status --json; uwf next --json; uwf validate --json.'
  printf '%s\n' 'Guardrail: never write application code before explicit developer approval.'
}

workspace_manifest() {
  [[ -f FOUNDATION_MANIFEST.yaml ]] || { printf 'Jalankan dari root workspace UWF.\n' >&2; exit 1; }
}

ensure_extension_artifacts() {
  local relative
  for relative in \
    Foundation/05-Features-Requirements/Feature-Gap-Audit.md \
    Foundation/06-UX-UI/Creative-Brief.md \
    Foundation/06-UX-UI/Responsive-Accessibility-Review.md \
    Foundation/06-UX-UI/Simulation-Plan.md \
    Foundation/06-UX-UI/Reference-Analysis.md \
    Foundation/06-UX-UI/Design-Reference-Registry.md \
    Foundation/06-UX-UI/FigCraft-Reference-Catalog.md \
    Foundation/00-Control/Capability-Matrix.md \
    Foundation/12-Handover/Release-Readiness.md \
    Foundation/14-Change-Management/README.md \
    Foundation/14-Change-Management/Backlog.md \
    Foundation/14-Change-Management/Revision-History.md; do
    if [[ ! -f "$relative" ]]; then
      mkdir -p "$(dirname "$relative")"
      cp "$UWF_HOME/$relative" "$relative"
    fi
  done
  mkdir -p Foundation/14-Change-Management/Requests
}

ensure_ui_reference_manifest_fields() {
  if ! grep -q '^  active_reference:' FOUNDATION_MANIFEST.yaml; then
    sed -i '/^ui_ux:/a\  active_reference: unset # unset | figcraft_public_repository | custom\n  reference_status: OPTIONAL # OPTIONAL | ANALYSIS_REQUIRED | ANALYZED | APPROVED | REJECTED' FOUNDATION_MANIFEST.yaml
  fi
}

template_command() {
  local action="${1:-list}" id="${2:-}"
  case "$action" in
    list)
      [[ $# -eq 1 || $# -eq 0 ]] || { printf 'Gunakan: uwf template [list|apply template-id]\n' >&2; exit 1; }
      printf '%s\n' 'Original UWF Foundation starter packs:'
      printf '%s\n' '- content-platform: articles, documentation, editorial, and media planning'
      printf '%s\n' '- marketplace: catalog, buyer/seller, order, and payment planning'
      printf '%s\n' '- dashboard: internal operations, analytics, and admin planning'
      printf '%s\n' '- hybrid-platform: coordinated multi-module web platform planning'
      ;;
    apply)
      [[ $# -eq 2 ]] || { printf 'Gunakan: uwf template apply template-id\n' >&2; exit 1; }
      workspace_manifest
      apply_starter_pack "$PWD" "$id"
      printf 'Starter pack ditambahkan untuk review: Foundation/04-Product-Modules/Starter-Pack-%s.md\n' "$id"
      printf '%s\n' 'Starter pack tidak mengubah objective, stack, atau implementation gate tanpa keputusan developer.'
      ;;
    *) printf 'Gunakan: uwf template [list|apply template-id]\n' >&2; exit 1 ;;
  esac
}

reference_command() {
  [[ $# -eq 0 || ( $# -eq 1 && "$1" == "figcraft" ) ]] || { printf 'Gunakan: uwf reference [figcraft]\n' >&2; exit 1; }
  workspace_manifest
  ensure_extension_artifacts
  ensure_ui_reference_manifest_fields
  printf '%s\n' 'Gunakan Foundation/06-UX-UI/Design-Reference-Registry.md lalu Reference-Analysis.md untuk mencatat pelajaran UI/UX dari referensi eksternal.'
  printf '%s\n' 'Clean-room rule: jangan menyalin kode, merek, logo, aset, screenshot, API privat, format file, atau komposisi UI khas.'
  printf '%s\n' 'Dampak di luar UI/UX harus melalui Change Request terpisah.'
  if [[ "${1:-}" == "figcraft" ]]; then
    local analysis="Foundation/06-UX-UI/Reference-Analysis-FigCraft.md"
    [[ -f "$analysis" ]] || cp Foundation/06-UX-UI/Reference-Analysis.md "$analysis"
    sed -i 's|^  active_reference:.*|  active_reference: figcraft_public_repository|; s|^  reference_status:.*|  reference_status: ANALYSIS_REQUIRED|' FOUNDATION_MANIFEST.yaml
    printf '%s\n' 'Katalog FigCraft: Foundation/06-UX-UI/FigCraft-Reference-Catalog.md'
    printf 'Analisis aktif dibuat: %s\n' "$analysis"
    printf '%s\n' 'Selesaikan analisis clean-room dan minta review developer sebelum membuat simulasi atau implementasi.'
  fi
}

capability_command() {
  workspace_manifest
  ensure_extension_artifacts
  sed -n '1,240p' Foundation/00-Control/Capability-Matrix.md
}

release_check_command() {
  workspace_manifest
  ensure_extension_artifacts
  if [[ ! -f Foundation/12-Handover/Release-Readiness.md ]]; then
    cp "$UWF_HOME/templates/release-readiness.md" Foundation/12-Handover/Release-Readiness.md
  fi
  printf '%s\n' 'Release-readiness checklist: Foundation/12-Handover/Release-Readiness.md'
  printf '%s\n' 'Complete evidence and developer approval before calling an implementation release stable.'
}

change_command() {
  local action="${1:-}"
  shift || true
  workspace_manifest
  ensure_extension_artifacts
  case "$action" in
    new)
      local title="${1:-}" stamp id request escaped_title
      [[ -n "$title" ]] || { printf 'Gunakan: uwf change new "Judul perubahan"\n' >&2; exit 1; }
      [[ "$title" != *$'\n'* ]] || { printf 'Judul perubahan harus satu baris.\n' >&2; exit 1; }
      stamp="$(date -u +%Y%m%dT%H%M%SZ)"
      id="CR-$stamp"
      request="Foundation/14-Change-Management/Requests/$id.md"
      cp "$UWF_HOME/templates/change-request.md" "$request"
      escaped_title="$(printf '%s' "$title" | sed 's/[&|]/\\&/g')"
      sed -i "s|{{ID}}|$id|g; s|{{TITLE}}|$escaped_title|g" "$request"
      sed -i "s|^  active_request:.*|  active_request: $id|; s|^  change_status:.*|  change_status: NEEDS_REVIEW|" FOUNDATION_MANIFEST.yaml
      printf 'Change Request dibuat: %s\nAnalisis dampak dulu; jangan mengubah implementasi sebelum developer memutuskan.\n' "$request"
      ;;
    assess)
      local id="${1:-}" request
      [[ -n "$id" ]] || { printf 'Gunakan: uwf change assess CR-id\n' >&2; exit 1; }
      [[ "$id" =~ ^CR-[0-9]{8}T[0-9]{6}Z$ ]] || { printf 'Format Change Request tidak valid: %s\n' "$id" >&2; exit 1; }
      request="Foundation/14-Change-Management/Requests/$id.md"
      [[ -f "$request" ]] || { printf 'Change Request tidak ditemukan: %s\n' "$id" >&2; exit 1; }
      printf 'Lengkapi impact analysis pada %s\n' "$request"
      printf '%s\n' 'Nilai dampak pada tujuan, UX, data, arsitektur, keamanan, biaya, test, rollback, dan migrasi. Developer memilih approve, revisi Foundation, defer, atau reject.'
      ;;
    list)
      find Foundation/14-Change-Management/Requests -maxdepth 1 -type f -name 'CR-*.md' -printf '%f\n' | sort
      ;;
    *) printf 'Gunakan: uwf change [new|assess|list]\n' >&2; exit 1 ;;
  esac
}

feature_gap_command() {
  [[ "${1:-}" == "audit" && $# -eq 1 ]] || { printf 'Gunakan: uwf feature-gap audit\n' >&2; exit 1; }
  workspace_manifest
  ensure_extension_artifacts
  local stamp report
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  report="Foundation/05-Features-Requirements/Feature-Gap-Audit-$stamp.md"
  cp Foundation/05-Features-Requirements/Feature-Gap-Audit.md "$report"
  printf 'Feature-gap audit draft dibuat: %s\nTinjau bersama developer; buat Change Request untuk setiap penambahan yang disetujui.\n' "$report"
}

ui_command() {
  local action="${1:-}"
  workspace_manifest
  ensure_extension_artifacts
  case "$action" in
    brief)
      printf '%s\n' 'Isi Foundation/06-UX-UI/Creative-Brief.md. Jika kosong, agent wajib memberi rekomendasi aman berdasarkan tujuan; jika terisi, rekomendasi harus mengikuti visi developer.'
      ;;
    review)
      printf '%s\n' 'Selesaikan Foundation/06-UX-UI/Responsive-Accessibility-Review.md sebelum memilih simulasi di Simulation-Plan.md. Review mobile, tablet, desktop, contrast, keyboard, reduced motion, dan performance.'
      ;;
    *) printf 'Gunakan: uwf ui [brief|review]\n' >&2; exit 1 ;;
  esac
}

review_stage() {
  local stage=""
  [[ $# -eq 0 ]] || stage="$1"
  [[ "$stage" =~ ^stage-[0-9]+$ ]] || { printf 'Gunakan: uwf review stage-N\n' >&2; exit 1; }
  "$UWF_HOME/scripts/validate-foundation.sh" "$PWD"
  printf 'Gunakan templates/stage-review.md untuk mencatat review.\n'
}

show_version() {
  if [[ -f "$UWF_HOME/VERSION" ]]; then
    printf 'UWF %s\n' "$(tr -d '\n' < "$UWF_HOME/VERSION")"
  else
    printf 'UWF version unknown\n'
  fi
}

check_update() {
  if [[ -d "$UWF_HOME/.git" ]]; then
    printf 'UWF source is a Git checkout at %s\n' "$UWF_HOME"
    printf 'Run git fetch --tags in that directory to inspect releases.\n'
  else
    printf 'UWF source is a copied workspace. Re-run the versioned installer to update the shared CLI.\n'
  fi
}

manifest_command() {
  [[ $# -eq 1 && "$1" == "check" ]] || { printf 'Gunakan: uwf manifest check\n' >&2; exit 1; }
  "$UWF_HOME/scripts/manifest-migrate.sh" "$PWD"
}

package_command() {
  "$UWF_HOME/scripts/package-release.sh" "$@"
}

uninstall_command() {
  "$UWF_HOME/scripts/uninstall.sh" "$@"
}

stack_command() {
  local action="list"
  [[ $# -eq 0 ]] || action="$1"
  "$UWF_HOME/scripts/stack-advisor.sh" "$action"
}

upgrade_online() {
  [[ $# -eq 1 && "$1" == "--prepare" ]] || {
    printf 'Gunakan: uwf upgrade online --prepare\n' >&2
    exit 1
  }
  "$UWF_HOME/scripts/upgrade-online.sh" "$PWD"
}

plugin_command() {
  [[ $# -gt 0 ]] || { printf 'Gunakan: uwf plugin [list|inspect|enable|disable] [plugin-id]\n' >&2; exit 1; }
  (
    cd "$PWD"
    "$UWF_HOME/scripts/plugin-manager.sh" "$@"
  )
}

automation_command() {
  [[ $# -eq 1 ]] || { printf 'Gunakan: uwf automation [prepare|status|kill]\n' >&2; exit 1; }
  "$UWF_HOME/scripts/automation-policy.sh" "$1"
}

approve_implementation() {
  local project=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="${2:-}"; shift 2 ;;
      *) printf 'Argumen tidak dikenal: %s\n' "$1" >&2; exit 1 ;;
    esac
  done
  [[ -n "$project" ]] || { printf 'Gunakan: uwf approve implementation --project "Nama Web"\n' >&2; exit 1; }
  [[ -f FOUNDATION_MANIFEST.yaml ]] || { printf 'Jalankan perintah ini dari root workspace UWF.\n' >&2; exit 1; }
  [[ -d Project-Implementasi ]] || { printf 'Project-Implementasi tidak ditemukan; mungkin sudah diaktifkan.\n' >&2; exit 1; }
  "$UWF_HOME/scripts/validate-foundation.sh" "$PWD" --gate || {
    printf 'Implementation approval blocked. Complete the Foundation issues above first.\n' >&2
    exit 1
  }
  local stamp
  stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  sed -i 's/implementation_gate: .*/implementation_gate: APPROVED/' FOUNDATION_MANIFEST.yaml
  sed -i 's/implementation_status: .*/implementation_status: APPROVED/' FOUNDATION_MANIFEST.yaml
  sed -i "s/last_developer_approval: .*/last_developer_approval: $stamp/" FOUNDATION_MANIFEST.yaml
  sed -i "s/last_updated: .*/last_updated: $stamp/" FOUNDATION_MANIFEST.yaml
  "$UWF_HOME/scripts/create-project.sh" "$project"
}

show_help() {
  cat <<'EOF'
Universal Web Foundation

Usage:
  uwf                         Start the interactive menu
  uwf init [nama-web]         Create a new UWF workspace
  uwf doctor                  Check command and PATH requirements
  uwf status                  Show current workspace status
  uwf status --json           Show machine-readable workspace status
  uwf next                    Show the active Foundation step
  uwf next --json             Show machine-readable active-stage guidance
  uwf validate                Validate the current Foundation workspace
  uwf validate --json         Validate with machine-readable result
  uwf context [--json]        Show mandatory context for terminal AI agents
  uwf review stage-N          Validate and review a Foundation stage
  uwf change [new|assess|list]
                              Record or inspect a reviewable scope change
  uwf feature-gap audit       Create a missing-requirements audit draft
  uwf ui [brief|review]       Guide the UI/UX creative-brief and review flow
  uwf template [list|apply id]
                              List or add an original Foundation starter pack
  uwf reference               Show the clean-room external-reference workflow
  uwf capability              Show capability maturity and limitations
  uwf release check           Open the implementation release-readiness checklist
  uwf stack [list|advise]     Show stack profiles or decision guidance
  uwf upgrade online --prepare
                              Create a draft online migration plan and archive snapshot
  uwf plugin [list|inspect|enable|disable] [id]
                              Manage approved workspace plugin decisions
  uwf automation [prepare|status|kill]
                              Manage automation policy and emergency stop
  uwf approve implementation --project "Nama Web"
                              Approve and create Project-Nama-Web
  uwf version                 Show UWF version
  uwf update [--check|--minor|--major|--edge]
                              Update stable patch by default; broader channels are explicit
  uwf manifest check          Check Foundation manifest compatibility
  uwf package [directory]     Build local source archive and checksum
  uwf uninstall --yes         Remove only the standard CLI installation
EOF
}

interactive() {
  printf '%s\n' 'Universal Web Foundation'
  printf '%s\n' '1. Buat proyek baru'
  printf '%s\n' '2. Lihat status Foundation di folder ini'
  printf '%s\n' '3. Validasi Foundation di folder ini'
  printf '%s\n' '4. Keluar'
  read -r -p 'Pilih: ' choice
  case "$choice" in
    1) init_project ;;
    2) show_status ;;
    3) "$UWF_HOME/scripts/validate-foundation.sh" "$PWD" ;;
    4) exit 0 ;;
    *) printf 'Pilihan tidak dikenal.\n' >&2; exit 1 ;;
  esac
}

case "${1:-}" in
  "") interactive ;;
  init) shift; init_project "$@" ;;
  doctor) "$UWF_HOME/scripts/doctor.sh" ;;
  status) shift; show_status "$@" ;;
  next) shift; show_next "$@" ;;
  validate) shift; "$UWF_HOME/scripts/validate-foundation.sh" "$PWD" "$@" ;;
  context) shift; show_context "$@" ;;
  review) shift; review_stage "$@" ;;
  stack) shift; stack_command "$@" ;;
  upgrade)
    shift
    [[ $# -gt 0 && "$1" == "online" ]] || { printf 'Gunakan: uwf upgrade online --prepare\n' >&2; exit 1; }
    shift
    upgrade_online "$@"
    ;;
  plugin) shift; plugin_command "$@" ;;
  automation) shift; automation_command "$@" ;;
  change) shift; change_command "$@" ;;
  feature-gap) shift; feature_gap_command "$@" ;;
  ui) shift; ui_command "$@" ;;
  template) shift; template_command "$@" ;;
  reference) shift; reference_command "$@" ;;
  capability) shift; capability_command "$@" ;;
  release) shift; [[ "${1:-}" == "check" && $# -eq 1 ]] || { printf 'Gunakan: uwf release check\n' >&2; exit 1; }; release_check_command ;;
  approve)
    shift
    [[ "${1:-}" == "implementation" ]] || { show_help; exit 1; }
    shift
    approve_implementation "$@"
    ;;
  version) show_version ;;
  update)
    shift
    "$UWF_HOME/scripts/update.sh" "$@"
    ;;
  manifest) shift; manifest_command "$@" ;;
  package) shift; package_command "$@" ;;
  uninstall) shift; uninstall_command "$@" ;;
  help|-h|--help) show_help ;;
  *) show_help; exit 1 ;;
esac
