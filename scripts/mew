show_next() {
  local manifest="$PWD/FOUNDATION_MANIFEST.yaml"
  [[ -f "$manifest" ]] || { printf 'FOUNDATION_MANIFEST.yaml tidak ditemukan di folder ini.\n' >&2; exit 1; }
  local stage
  stage="$(section_value foundation current_stage_name "$manifest")"
  [[ -n "$stage" ]] || stage="belum dipilih"
  if [[ "${1:-}" == "--json" ]]; then
    printf '{"schema":"mew-next/v1","current_stage":"%s","next_action":"read_question_bank_answer_active_stage_then_validate"}\n' "$(json_escape "$stage")"
    return
  fi
  printf 'Tahap aktif: %s\n' "$stage"
  printf 'Langkah berikutnya: baca bahan tahap aktif dan Question Bank yang relevan, catat keputusan, lalu jalankan mew validate.\n'
}

show_context() {
  [[ -f FOUNDATION_MANIFEST.yaml ]] || { printf 'Jalankan dari root workspace MEW.\n' >&2; exit 1; }
  if [[ "${1:-}" == "--json" ]]; then
    printf '{"schema":"mew-agent-context/v1","read_order":["FOUNDATION_MANIFEST.yaml","Foundation/00-Control/Open-Questions.md","Foundation/00-Control/Decision-Log.md","active Foundation stage","Composition Manifest when present","current status report"],"commands":{"status":"mew status --json","next":"mew next --json","validate":"mew validate --json","runtime":"mew runtime prepare","compose":"mew compose plan"},"guardrail":"Do not implement application code until the developer explicitly approves the implementation gate."}\n'
    return
  fi
  printf '%s\n' 'MEW agent context'
  printf '%s\n' '1. Read FOUNDATION_MANIFEST.yaml.'
  printf '%s\n' '2. Read Foundation/00-Control/Open-Questions.md.'
  printf '%s\n' '3. Read Foundation/00-Control/Decision-Log.md.'
  printf '%s\n' '4. Read the active Foundation stage and current status report.'
  printf '%s\n' '5. Read the Composition Manifest and source policy when they apply.'
  printf '%s\n' '6. Run: mew status --json; mew next --json; mew validate --json.'
  printf '%s\n' 'Guardrail: never write application code before explicit developer approval.'
}

workspace_manifest() {
  [[ -f FOUNDATION_MANIFEST.yaml ]] || { printf 'Jalankan dari root workspace MEW.\n' >&2; exit 1; }
}

ensure_extension_artifacts() {
  local relative
  for relative in \
    Foundation/00-Control/Status-Report.md \
    Foundation/00-Control/Action-Journal.md \
    Foundation/05-Features-Requirements/Feature-Gap-Audit.md \
    Foundation/06-UX-UI/Creative-Brief.md \
    Foundation/06-UX-UI/Responsive-Accessibility-Review.md \
    Foundation/06-UX-UI/Simulation-Plan.md \
    Foundation/06-UX-UI/Reference-Analysis.md \
    Foundation/06-UX-UI/Design-Reference-Registry.md \
    Foundation/06-UX-UI/FigCraft-Reference-Catalog.md \
    Foundation/00-Control/Capability-Matrix.md \
    Foundation/12-Handover/Release-Readiness.md \
    Foundation/14-Change-Management/README.md \
    Foundation/14-Change-Management/Backlog.md \
    Foundation/14-Change-Management/Revision-History.md \
    Foundation/15-Engineering-Materials/README.md \
    Foundation/15-Engineering-Materials/Material-Catalog.md \
    Foundation/15-Engineering-Materials/Material-Lifecycle.md \
    Foundation/15-Engineering-Materials/Composition-Manifest.md \
    Foundation/16-External-Reference-Evidence/README.md \
    Foundation/16-External-Reference-Evidence/Source-Policy.md \
    Foundation/16-External-Reference-Evidence/Evidence-Registry.md \
    Foundation/17-Research-Content-Operations/README.md \
    Foundation/17-Research-Content-Operations/Research-Policy.md \
    Foundation/17-Research-Content-Operations/Taxonomy-Content-Map.md \
    Foundation/17-Research-Content-Operations/Scale-Batch-Plan.md \
    Foundation/17-Research-Content-Operations/Publish-Controls.md \
    Foundation/17-Research-Content-Operations/Freshness-Capacity-Plan.md; do
    if [[ ! -f "$relative" ]]; then
      mkdir -p "$(dirname "$relative")"
      cp "$MEW_HOME/$relative" "$relative"
    fi
  done
  mkdir -p Foundation/14-Change-Management/Requests
  mkdir -p Foundation/16-External-Reference-Evidence/Evidence-Cards
}

prepare_workspace_extensions() {
  workspace_manifest
  "$MEW_HOME/scripts/manifest-migrate.sh" "$PWD" >/dev/null
  ensure_extension_artifacts
  for directory in agent tools policies schemas evaluations; do
    [[ -d "$directory" ]] || cp -R "$MEW_HOME/$directory" "$directory"
  done
}

ensure_ui_reference_manifest_fields() {
  if ! grep -q '^  active_reference:' FOUNDATION_MANIFEST.yaml; then
    sed -i '/^ui_ux:/a\  active_reference: unset # unset | figcraft_public_repository | custom\n  active_reference_name: unset\n  reference_analysis_file: unset\n  reference_status: OPTIONAL # OPTIONAL | ANALYSIS_REQUIRED | ANALYZED | APPROVED | REJECTED' FOUNDATION_MANIFEST.yaml
  fi
}

analysis_field_filled() {
  local file="$1" label="$2"
  awk -v label="$label" '
    index($0, "- " label ":") == 1 {
      value = substr($0, length(label) + 4)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", value)
      if (length(value) > 0) found = 1
    }
    END { exit found ? 0 : 1 }
  ' "$file"
}

complete_active_reference() {
  local expected="$1" active analysis
  active="$(section_value ui_ux active_reference FOUNDATION_MANIFEST.yaml)"
  analysis="$(section_value ui_ux reference_analysis_file FOUNDATION_MANIFEST.yaml)"
  case "$expected" in
    figcraft) [[ "$active" == "figcraft_public_repository" ]] || { printf 'FigCraft bukan referensi aktif. Jalankan: mew reference figcraft\n' >&2; exit 1; } ;;
    custom) [[ "$active" == "custom" ]] || { printf 'Referensi custom bukan referensi aktif. Jalankan: mew reference custom "Nama"\n' >&2; exit 1; } ;;
  esac
  [[ -n "$analysis" && "$analysis" != "unset" && -f "$analysis" ]] || { printf 'File analisis aktif tidak ditemukan.\n' >&2; exit 1; }
  for label in "Source URL or name" "Reference catalog category (if registered)" "General principle worth considering" "New, original name and structure" "Developer decision"; do
    analysis_field_filled "$analysis" "$label" || { printf 'Lengkapi field analisis: %s\n' "$label" >&2; exit 1; }
  done
  sed -i 's|^  reference_status:.*|  reference_status: ANALYZED|' FOUNDATION_MANIFEST.yaml
  printf 'Analisis referensi selesai dicatat: %s\n' "$analysis"
  printf '%s\n' 'Status menjadi ANALYZED. Simulasi tetap DRAFT sampai developer menyetujuinya.'
}

template_command() {
  local action="${1:-list}" id="${2:-}"
  case "$action" in
    list)
      [[ $# -eq 1 || $# -eq 0 ]] || { printf 'Gunakan: mew template [list|apply template-id]\n' >&2; exit 1; }
      printf '%s\n' 'Original MEW Foundation starter packs:'
      printf '%s\n' '- content-platform: articles, documentation, editorial, and media planning'
      printf '%s\n' '- marketplace: catalog, buyer/seller, order, and payment planning'
      printf '%s\n' '- dashboard: internal operations, analytics, and admin planning'
      printf '%s\n' '- hybrid-platform: coordinated multi-module web platform planning'
      ;;
    apply)
      [[ $# -eq 2 ]] || { printf 'Gunakan: mew template apply template-id\n' >&2; exit 1; }
      workspace_manifest
      apply_starter_pack "$PWD" "$id"
      printf 'Starter pack ditambahkan untuk review: Foundation/04-Product-Modules/Starter-Pack-%s.md\n' "$id"
      printf '%s\n' 'Starter pack tidak mengubah objective, stack, atau implementation gate tanpa keputusan developer.'
      ;;
    *) printf 'Gunakan: mew template [list|apply template-id]\n' >&2; exit 1 ;;
  esac
}

reference_command() {
  workspace_manifest
  ensure_extension_artifacts
  ensure_ui_reference_manifest_fields
  case "${1:-}" in
    "")
      printf '%s\n' 'Gunakan Foundation/06-UX-UI/Design-Reference-Registry.md lalu Reference-Analysis.md untuk mencatat pelajaran UI/UX dari referensi eksternal.'
      printf '%s\n' 'Clean-room rule: jangan menyalin kode, merek, logo, aset, screenshot, API privat, format file, atau komposisi UI khas.'
      printf '%s\n' 'Dampak di luar UI/UX harus melalui Change Request terpisah.'
      ;;
    figcraft)
      [[ $# -eq 1 ]] || { printf 'Gunakan: mew reference figcraft\n' >&2; exit 1; }
      local analysis="Foundation/06-UX-UI/Reference-Analysis-FigCraft.md"
      [[ -f "$analysis" ]] || cp Foundation/06-UX-UI/Reference-Analysis.md "$analysis"
      sed -i 's|^  active_reference:.*|  active_reference: figcraft_public_repository|; s|^  active_reference_name:.*|  active_reference_name: FigCraft public repository|; s|^  reference_analysis_file:.*|  reference_analysis_file: Foundation/06-UX-UI/Reference-Analysis-FigCraft.md|; s|^  reference_status:.*|  reference_status: ANALYSIS_REQUIRED|' FOUNDATION_MANIFEST.yaml
      printf '%s\n' 'Katalog FigCraft: Foundation/06-UX-UI/FigCraft-Reference-Catalog.md'
      printf 'Analisis aktif dibuat: %s\n' "$analysis"
      printf '%s\n' 'Selesaikan analisis clean-room dan jalankan: mew reference complete figcraft'
      ;;
    custom)
      [[ $# -eq 2 && -n "${2:-}" ]] || { printf 'Gunakan: mew reference custom "Nama referensi"\n' >&2; exit 1; }
      local custom_name="$2" custom_slug custom_analysis escaped_name
      custom_slug="$(slugify "$custom_name")"
      [[ -n "$custom_slug" ]] || { printf 'Nama referensi custom tidak valid.\n' >&2; exit 1; }
      custom_analysis="Foundation/06-UX-UI/Reference-Analysis-Custom-$custom_slug.md"
      [[ -f "$custom_analysis" ]] || cp Foundation/06-UX-UI/Reference-Analysis.md "$custom_analysis"
      escaped_name="$(printf '%s' "$custom_name" | sed 's/[&|]/\\&/g')"
      sed -i "s|^  active_reference:.*|  active_reference: custom|; s|^  active_reference_name:.*|  active_reference_name: $escaped_name|; s|^  reference_analysis_file:.*|  reference_analysis_file: $custom_analysis|; s|^  reference_status:.*|  reference_status: ANALYSIS_REQUIRED|" FOUNDATION_MANIFEST.yaml
      printf 'Analisis referensi custom dibuat: %s\n' "$custom_analysis"
      printf '%s\n' 'Selesaikan analisis clean-room dan jalankan: mew reference complete custom'
      ;;
    complete)
      [[ $# -eq 2 ]] || { printf 'Gunakan: mew reference complete [figcraft|custom]\n' >&2; exit 1; }
      case "$2" in figcraft|custom) complete_active_reference "$2" ;; *) printf 'Gunakan: mew reference complete [figcraft|custom]\n' >&2; exit 1 ;; esac
      ;;
    *) printf 'Gunakan: mew reference [figcraft|custom "Nama"|complete figcraft|complete custom]\n' >&2; exit 1 ;;
  esac
}

capability_command() {
  workspace_manifest
  ensure_extension_artifacts
  sed -n '1,240p' Foundation/00-Control/Capability-Matrix.md
}

runtime_command() {
  [[ "${1:-}" == "prepare" && $# -eq 1 ]] || { printf 'Gunakan: mew runtime prepare\n' >&2; exit 1; }
  workspace_manifest
  local profile="Foundation/00-Control/Agent-Runtime-Profile.md"
  [[ -f "$profile" ]] || cp "$MEW_HOME/templates/runtime-profile.md" "$profile"
  set_section_value agent_runtime profile_status DECLARED
  printf 'Runtime profile dibuat: %s\n' "$profile"
  printf '%s\n' 'Isi hanya kemampuan yang benar-benar tersedia; kemampuan tidak diketahui tetap harus dilaporkan sebagai unknown atau unavailable.'
}

material_command() {
  local action="${1:-list}"
  workspace_manifest
  ensure_extension_artifacts
  case "$action" in
    list)
      [[ $# -eq 1 || $# -eq 0 ]] || { printf 'Gunakan: mew material [list|assess]\n' >&2; exit 1; }
      sed -n '1,260p' Foundation/15-Engineering-Materials/Material-Catalog.md
      ;;
    assess)
      [[ $# -eq 1 ]] || { printf 'Gunakan: mew material assess\n' >&2; exit 1; }
      set_section_value composition status REVIEW
      printf '%s\n' 'Lengkapi Foundation/15-Engineering-Materials/Composition-Manifest.md dengan bahan terpilih, bahan ditolak, bukti, risiko, biaya, dan keputusan developer.'
      ;;
    *) printf 'Gunakan: mew material [list|assess]\n' >&2; exit 1 ;;
  esac
}

compose_command() {
  [[ "${1:-}" == "plan" && $# -eq 1 ]] || { printf 'Gunakan: mew compose plan\n' >&2; exit 1; }
  workspace_manifest
  ensure_extension_artifacts
  set_section_value composition status REVIEW
  printf '%s\n' 'Composition Manifest: Foundation/15-Engineering-Materials/Composition-Manifest.md'
  printf '%s\n' 'Agent wajib menjelaskan tujuan, hierarchy, bahan terpilih/ditolak, kompatibilitas, bukti, risiko, biaya, dan keputusan terbuka.'
}

evidence_command() {
  local action="${1:-}"
  shift || true
  workspace_manifest
  ensure_extension_artifacts
  case "$action" in
    add)
      local name="${1:-}" slug card escaped
      [[ $# -eq 1 && -n "$name" ]] || { printf 'Gunakan: mew evidence add "Nama sumber atau bahan"\n' >&2; exit 1; }
      slug="$(slugify "$name")"
      [[ -n "$slug" ]] || { printf 'Nama evidence tidak valid.\n' >&2; exit 1; }
      card="Foundation/16-External-Reference-Evidence/Evidence-Cards/$slug.md"
      [[ ! -e "$card" ]] || { printf 'Evidence Card sudah ada: %s\n' "$card" >&2; exit 1; }
      cp "$MEW_HOME/templates/evidence-card.md" "$card"
      escaped="$(printf '%s' "$slug" | sed 's/[&|]/\\&/g')"
      sed -i "s|{{ID}}|EV-$escaped|" "$card"
      set_section_value external_evidence status PLANNED
      printf 'Evidence Card dibuat: %s\n' "$card"
      ;;
    list)
      [[ $# -eq 0 ]] || { printf 'Gunakan: mew evidence [list|add "Nama"]\n' >&2; exit 1; }
      find Foundation/16-External-Reference-Evidence/Evidence-Cards -maxdepth 1 -type f -name '*.md' -printf '%f\n' | sort
      ;;
    *) printf 'Gunakan: mew evidence [list|add "Nama"]\n' >&2; exit 1 ;;
  esac
}

research_command() {
  [[ "${1:-}" == "prepare" && $# -eq 1 ]] || { printf 'Gunakan: mew research prepare\n' >&2; exit 1; }
  workspace_manifest
  ensure_extension_artifacts
  local plan="Foundation/17-Research-Content-Operations/Research-Plan.md"
  [[ -f "$plan" ]] || cp "$MEW_HOME/templates/research-plan.md" "$plan"
  set_section_value external_evidence status PLANNED
  set_section_value content_operations research_policy_status DRAFT
  printf 'Research plan dibuat: %s\n' "$plan"
  printf '%s\n' 'Ini hanya rencana. MEW tidak melakukan web search atau publishing otomatis.'
}

taxonomy_command() {
  [[ "${1:-}" == "plan" && $# -eq 1 ]] || { printf 'Gunakan: mew taxonomy plan\n' >&2; exit 1; }
  workspace_manifest
  ensure_extension_artifacts
  set_section_value content_operations taxonomy_status DRAFT
  printf '%s\n' 'Taxonomy & Content Map: Foundation/17-Research-Content-Operations/Taxonomy-Content-Map.md'
}

active_implementation_project() {
  local projects=()
  local item
  while IFS= read -r item; do projects+=("$item"); done < <(find . -maxdepth 1 -mindepth 1 -type d -name 'Project-*' ! -name 'Project-Implementasi' -printf '%f\n' | sort)
  [[ "${#projects[@]}" -eq 1 ]] || { printf 'Content operations membutuhkan tepat satu Project-Name-Project aktif; ditemukan %s.\n' "${#projects[@]}" >&2; return 1; }
  printf '%s' "${projects[0]}"
}

operations_command() {
  local action="${1:-status}"
  workspace_manifest
  ensure_extension_artifacts
  case "$action" in
    prepare)
      [[ $# -eq 1 ]] || { printf 'Gunakan: mew operations [prepare|status|validate]\n' >&2; exit 1; }
      grep -q '^  implementation_gate: APPROVED' FOUNDATION_MANIFEST.yaml || { printf 'Content operations hanya dapat diaktifkan setelah implementation gate disetujui.\n' >&2; exit 1; }
      local project operations
      project="$(active_implementation_project)" || exit 1
      operations="$project/Operations"
      mkdir -p "$operations"
      for pair in "Content-Map.md:content-map.md" "Production-Queue.md:production-queue.md" "Rights-Ledger.md:rights-ledger.md" "Run-History.md:operations-run-history.md" "Freshness-Capacity-Plan.md:freshness-capacity-plan.md"; do
        local target="${pair%%:*}" source="${pair##*:}"
        [[ -f "$operations/$target" ]] || cp "$MEW_HOME/templates/$source" "$operations/$target"
      done
      set_section_value content_operations enabled true
      set_section_value content_operations status PLANNED
      set_section_value content_operations operations_root "$operations"
      printf 'Content operations disiapkan: %s\n' "$operations"
      ;;
    status)
      [[ $# -eq 1 ]] || { printf 'Gunakan: mew operations [prepare|status|validate]\n' >&2; exit 1; }
      printf '%s\n' "content_operations.enabled: $(section_value content_operations enabled FOUNDATION_MANIFEST.yaml)
content_operations.status: $(section_value content_operations status FOUNDATION_MANIFEST.yaml)
content_operations.mode: $(section_value content_operations mode FOUNDATION_MANIFEST.yaml)
content_operations.scale_target: $(section_value content_operations scale_target FOUNDATION_MANIFEST.yaml)
content_operations.publishing_status: $(section_value content_operations publishing_status FOUNDATION_MANIFEST.yaml)"
      ;;
    validate)
      [[ $# -eq 1 ]] || { printf 'Gunakan: mew operations [prepare|status|validate]\n' >&2; exit 1; }
      "$MEW_HOME/scripts/validate-foundation.sh" "$PWD"
      ;;
    *) printf 'Gunakan: mew operations [prepare|status|validate]\n' >&2; exit 1 ;;
  esac
}

content_command() {
  [[ "${1:-}" == "plan" && "${2:-}" == "--count" && $# -eq 3 && "${3:-}" =~ ^[1-9][0-9]*$ ]] || { printf 'Gunakan: mew content plan --count JUMLAH\n' >&2; exit 1; }
  workspace_manifest
  local count="$3"
  [[ "$(section_value content_operations enabled FOUNDATION_MANIFEST.yaml)" == "true" ]] || { printf 'Jalankan mew operations prepare setelah implementation gate disetujui.\n' >&2; exit 1; }
  set_section_value content_operations scale_target "$count"
  printf 'Target konten dicatat: %s. Lengkapi Scale-Batch-Plan.md sebelum drafting atau writes.\n' "$count"
}

tool_command() {
  workspace_manifest
  prepare_workspace_extensions
  (
    cd "$PWD"
    "$MEW_HOME/tools/runners/mew-tool.sh" "$MEW_HOME" "$PWD" "$@"
  )
}

agent_command() {
  local action="${1:-status}"
  workspace_manifest
  prepare_workspace_extensions
  case "$action" in
    status)
      [[ $# -eq 1 ]] || { printf 'Gunakan: mew agent [status|route]\n' >&2; exit 1; }
      printf 'agent_orchestration.status: %s\n' "$(section_value agent_orchestration status FOUNDATION_MANIFEST.yaml)"
      printf 'agent_orchestration.mode: %s\n' "$(section_value agent_orchestration mode FOUNDATION_MANIFEST.yaml)"
      printf 'agent_orchestration.question_budget: %s\n' "$(section_value agent_orchestration question_budget FOUNDATION_MANIFEST.yaml)"
      printf 'Status protocol: Foundation/00-Control/Status-Report.md\nAction journal: Foundation/00-Control/Action-Journal.md\n'
      ;;
    route)
      [[ $# -eq 1 ]] || { printf 'Gunakan: mew agent [status|route]\n' >&2; exit 1; }
      set_section_value agent_orchestration status ROUTED
      cat agent/Routing-Rules.yaml
      ;;
    *) printf 'Gunakan: mew agent [status|route]\n' >&2; exit 1 ;;
  esac
}

job_command() {
  local action="${1:-list}" id="${2:-}" jobs
  workspace_manifest
  prepare_workspace_extensions
  jobs="Foundation/00-Control/Jobs"
  mkdir -p "$jobs"
  case "$action" in
    list)
      [[ $# -eq 1 || $# -eq 0 ]] || { printf 'Gunakan: mew job [list|inspect ID|cancel ID]\n' >&2; exit 1; }
      find "$jobs" -maxdepth 1 -type f -name 'JOB-*.md' -printf '%f\n' | sed 's/\.md$//' | sort
      ;;
    inspect)
      [[ $# -eq 2 && "$id" =~ ^JOB-[A-Za-z0-9._-]+$ && -f "$jobs/$id.md" ]] || { printf 'Job tidak ditemukan atau tidak valid.\n' >&2; exit 1; }
      cat "$jobs/$id.md"
      ;;
    cancel)
      [[ $# -eq 2 && "$id" =~ ^JOB-[A-Za-z0-9._-]+$ && -f "$jobs/$id.md" ]] || { printf 'Job tidak ditemukan atau tidak valid.\n' >&2; exit 1; }
      grep -q '^Status: CANCELLED$' "$jobs/$id.md" || printf 'Status: CANCELLED\n' >>"$jobs/$id.md"
      printf '| %s | Job Control | %s | cancel | local job record | cancelled | %s | not required |\n' "$(date -u +%Y%m%dT%H%M%SZ)" "$id" "$jobs/$id.md" >>Foundation/00-Control/Action-Journal.md
      printf 'Job ditandai CANCELLED: %s\n' "$id"
      ;;
    *) printf 'Gunakan: mew job [list|inspect ID|cancel ID]\n' >&2; exit 1 ;;
  esac
}

evaluation_command() {
  local action="${1:-list}" target="${2:-}"
  workspace_manifest
  prepare_workspace_extensions
  case "$action" in
    list)
      [[ $# -eq 1 || $# -eq 0 ]] || { printf 'Gunakan: mew evaluation [list|inspect NAME|run regression]\n' >&2; exit 1; }
      find evaluations/scenarios -maxdepth 1 -type f -name '*.md' -printf '%f\n' | sed 's/\.md$//' | sort
      ;;
    inspect)
      [[ $# -eq 2 && "$target" =~ ^[a-z0-9-]+$ && -f "evaluations/scenarios/$target.md" ]] || { printf 'Scenario tidak ditemukan atau tidak valid.\n' >&2; exit 1; }
      cat "evaluations/scenarios/$target.md"
      ;;
    run)
      [[ $# -eq 2 && "$target" == "regression" ]] || { printf 'Gunakan: mew evaluation run regression\n' >&2; exit 1; }
      "$MEW_HOME/evaluations/regression/run.sh"
      ;;
    *) printf 'Gunakan: mew evaluation [list|inspect NAME|run regression]\n' >&2; exit 1 ;;
  esac
}

release_check_command() {
  workspace_manifest
  ensure_extension_artifacts
  if [[ ! -f Foundation/12-Handover/Release-Readiness.md ]]; then
    cp "$MEW_HOME/templates/release-readiness.md" Foundation/12-Handover/Release-Readiness.md
  fi
  printf '%s\n' 'Release-readiness checklist: Foundation/12-Handover/Release-Readiness.md'
  printf '%s\n' 'Complete evidence and developer approval before calling an implementation release stable.'
}

change_command() {
  local action="${1:-}"
  shift || true
  workspace_manifest
  ensure_extension_artifacts
  case "$action" in
    new)
      local title="${1:-}" stamp id request escaped_title
      [[ -n "$title" ]] || { printf 'Gunakan: mew change new "Judul perubahan"\n' >&2; exit 1; }
      [[ "$title" != *$'\n'* ]] || { printf 'Judul perubahan harus satu baris.\n' >&2; exit 1; }
      stamp="$(date -u +%Y%m%dT%H%M%SZ)"
      id="CR-$stamp"
      request="Foundation/14-Change-Management/Requests/$id.md"
      cp "$MEW_HOME/templates/change-request.md" "$request"
      escaped_title="$(printf '%s' "$title" | sed 's/[&|]/\\&/g')"
      sed -i "s|{{ID}}|$id|g; s|{{TITLE}}|$escaped_title|g" "$request"
      sed -i "s|^  active_request:.*|  active_request: $id|; s|^  change_status:.*|  change_status: NEEDS_REVIEW|" FOUNDATION_MANIFEST.yaml
      printf 'Change Request dibuat: %s\nAnalisis dampak dulu; jangan mengubah implementasi sebelum developer memutuskan.\n' "$request"
      ;;
    assess)
      local id="${1:-}" request
      [[ -n "$id" ]] || { printf 'Gunakan: mew change assess CR-id\n' >&2; exit 1; }
      [[ "$id" =~ ^CR-[0-9]{8}T[0-9]{6}Z$ ]] || { printf 'Format Change Request tidak valid: %s\n' "$id" >&2; exit 1; }
      request="Foundation/14-Change-Management/Requests/$id.md"
      [[ -f "$request" ]] || { printf 'Change Request tidak ditemukan: %s\n' "$id" >&2; exit 1; }
      printf 'Lengkapi impact analysis pada %s\n' "$request"
      printf '%s\n' 'Nilai dampak pada tujuan, UX, data, arsitektur, keamanan, biaya, test, rollback, dan migrasi. Developer memilih approve, revisi Foundation, defer, atau reject.'
      ;;
    list)
      find Foundation/14-Change-Management/Requests -maxdepth 1 -type f -name 'CR-*.md' -printf '%f\n' | sort
      ;;
    *) printf 'Gunakan: mew change [new|assess|list]\n' >&2; exit 1 ;;
  esac
}

feature_gap_command() {
  [[ "${1:-}" == "audit" && $# -eq 1 ]] || { printf 'Gunakan: mew feature-gap audit\n' >&2; exit 1; }
  workspace_manifest
  ensure_extension_artifacts
  local stamp report
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  report="Foundation/05-Features-Requirements/Feature-Gap-Audit-$stamp.md"
  cp Foundation/05-Features-Requirements/Feature-Gap-Audit.md "$report"
  printf 'Feature-gap audit draft dibuat: %s\nTinjau bersama developer; buat Change Request untuk setiap penambahan yang disetujui.\n' "$report"
}

ui_command() {
  local action="${1:-}"
  workspace_manifest
  ensure_extension_artifacts
  case "$action" in
    brief)
      printf '%s\n' 'Isi Foundation/06-UX-UI/Creative-Brief.md. Jika kosong, agent wajib memberi rekomendasi aman berdasarkan tujuan; jika terisi, rekomendasi harus mengikuti visi developer.'
      ;;
    review)
      printf '%s\n' 'Selesaikan Foundation/06-UX-UI/Responsive-Accessibility-Review.md sebelum memilih simulasi di Simulation-Plan.md. Review mobile, tablet, desktop, contrast, keyboard, reduced motion, dan performance.'
      ;;
    *) printf 'Gunakan: mew ui [brief|review]\n' >&2; exit 1 ;;
  esac
}

review_stage() {
  local stage=""
  [[ $# -eq 0 ]] || stage="$1"
  [[ "$stage" =~ ^stage-[0-9]+$ ]] || { printf 'Gunakan: mew review stage-N\n' >&2; exit 1; }
  prepare_workspace_extensions
  "$MEW_HOME/scripts/validate-foundation.sh" "$PWD"
  printf 'Gunakan templates/stage-review.md untuk mencatat review.\n'
}

show_version() {
  if [[ -f "$MEW_HOME/VERSION" ]]; then
    printf 'MEW %s\n' "$(tr -d '\n' < "$MEW_HOME/VERSION")"
  else
    printf 'MEW version unknown\n'
  fi
}

check_update() {
  if [[ -d "$MEW_HOME/.git" ]]; then
    printf 'MEW source is a Git checkout at %s\n' "$MEW_HOME"
    printf 'Run git fetch --tags in that directory to inspect releases.\n'
  else
    printf 'MEW source is a copied workspace. Re-run the versioned installer to update the shared CLI.\n'
  fi
}

manifest_command() {
  [[ $# -eq 1 && "$1" == "check" ]] || { printf 'Gunakan: mew manifest check\n' >&2; exit 1; }
  "$MEW_HOME/scripts/manifest-migrate.sh" "$PWD"
}

package_command() {
  "$MEW_HOME/scripts/package-release.sh" "$@"
}

uninstall_command() {
  "$MEW_HOME/scripts/uninstall.sh" "$@"
}

stack_command() {
  local action="list"
  [[ $# -eq 0 ]] || action="$1"
  "$MEW_HOME/scripts/stack-advisor.sh" "$action"
}

upgrade_online() {
  [[ $# -eq 1 && "$1" == "--prepare" ]] || {
    printf 'Gunakan: mew upgrade online --prepare\n' >&2
    exit 1
  }
  "$MEW_HOME/scripts/upgrade-online.sh" "$PWD"
}

plugin_command() {
  [[ $# -gt 0 ]] || { printf 'Gunakan: mew plugin [list|inspect|enable|disable] [plugin-id]\n' >&2; exit 1; }
  (
    cd "$PWD"
    "$MEW_HOME/scripts/plugin-manager.sh" "$@"
  )
}

automation_command() {
  [[ $# -eq 1 ]] || { printf 'Gunakan: mew automation [prepare|status|kill]\n' >&2; exit 1; }
  "$MEW_HOME/scripts/automation-policy.sh" "$1"
}

approve_implementation() {
  local project=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) project="${2:-}"; shift 2 ;;
      *) printf 'Argumen tidak dikenal: %s\n' "$1" >&2; exit 1 ;;
    esac
  done
  [[ -n "$project" ]] || { printf 'Gunakan: mew approve implementation --project "Name-Project"\n' >&2; exit 1; }
  [[ -f FOUNDATION_MANIFEST.yaml ]] || { printf 'Jalankan perintah ini dari root workspace MEW.\n' >&2; exit 1; }
  prepare_workspace_extensions
  [[ -d Project-Implementasi ]] || { printf 'Project-Implementasi tidak ditemukan; mungkin sudah diaktifkan.\n' >&2; exit 1; }
  "$MEW_HOME/scripts/validate-foundation.sh" "$PWD" --gate || {
    printf 'Implementation approval blocked. Complete the Foundation issues above first.\n' >&2
    exit 1
  }
  local stamp
  stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  sed -i 's/implementation_gate: .*/implementation_gate: APPROVED/' FOUNDATION_MANIFEST.yaml
  sed -i 's/implementation_status: .*/implementation_status: APPROVED/' FOUNDATION_MANIFEST.yaml
  sed -i "s/last_developer_approval: .*/last_developer_approval: $stamp/" FOUNDATION_MANIFEST.yaml
  sed -i "s/last_updated: .*/last_updated: $stamp/" FOUNDATION_MANIFEST.yaml
  "$MEW_HOME/scripts/create-project.sh" "$project"
}

show_help() {
  cat <<'EOF'
Madevi Engineer Website

Usage:
  mew                         Start the interactive menu
  mew init [Name-Project]     Create a new MEW workspace
  mew doctor                  Check command and PATH requirements
  mew status                  Show current workspace status
  mew status --json           Show machine-readable workspace status
  mew next                    Show the active Foundation step
  mew next --json             Show machine-readable active-stage guidance
  mew validate                Validate the current Foundation workspace
  mew validate --json         Validate with machine-readable result
  mew context [--json]        Show mandatory context for terminal AI agents
  mew review stage-N          Validate and review a Foundation stage
  mew change [new|assess|list]
                              Record or inspect a reviewable scope change
  mew feature-gap audit       Create a missing-requirements audit draft
  mew ui [brief|review]       Guide the UI/UX creative-brief and review flow
  mew template [list|apply id]
                              List or add an original Foundation starter pack
  mew reference               Show the clean-room external-reference workflow
  mew runtime prepare         Create a truthful agent runtime-capability profile
  mew material [list|assess]  View material model or begin an assessment
  mew compose plan            Open the required engineering Composition Manifest
  mew evidence [list|add "Name"]
                              Record a reviewed external evidence card
  mew research prepare        Create a research plan; does not run web search
  mew taxonomy plan           Open taxonomy and content-map planning
  mew operations [prepare|status|validate]
                              Prepare controlled post-implementation content operations
  mew content plan --count N  Record a content target after operations preparation
  mew tool [list|inspect ID|doctor|capability|run ID --dry-run]
                              Inspect or safely dry-run a local MEW tool
  mew agent [status|route]    Show agent orchestration status or routing rules
  mew job [list|inspect ID|cancel ID]
                              Inspect or cancel a recorded local tool job
  mew evaluation [list|inspect NAME|run regression]
                              Inspect scenarios or run regression checks
  mew capability              Show capability maturity and limitations
  mew release check           Open the implementation release-readiness checklist
  mew stack [list|advise]     Show stack profiles or decision guidance
  mew upgrade online --prepare
                              Create a draft online migration plan and archive snapshot
  mew plugin [list|inspect|enable|disable] [id]
                              Manage approved workspace plugin decisions
  mew automation [prepare|status|kill]
                              Manage automation policy and emergency stop
  mew approve implementation --project "Name-Project"
                              Approve and create Project-Name-Project
  mew version                 Show MEW version
  mew update [--check|--minor|--major|--edge]
                              Update stable patch by default; broader channels are explicit
  mew manifest check          Check Foundation manifest compatibility
  mew package [directory]     Build local source archive and checksum
  mew uninstall --yes         Remove only the standard CLI installation
EOF
}

interactive() {
  printf '%s\n' 'Madevi Engineer Website'
  printf '%s\n' '1. Buat proyek baru'
  printf '%s\n' '2. Lihat status Foundation di folder ini'
  printf '%s\n' '3. Validasi Foundation di folder ini'
  printf '%s\n' '4. Keluar'
  read -r -p 'Pilih: ' choice
  case "$choice" in
    1) init_project ;;
    2) show_status ;;
    3) "$MEW_HOME/scripts/validate-foundation.sh" "$PWD" ;;
    4) exit 0 ;;
    *) printf 'Pilihan tidak dikenal.\n' >&2; exit 1 ;;
  esac
}

case "${1:-}" in
  "") interactive ;;
  init) shift; init_project "$@" ;;
  doctor) "$MEW_HOME/scripts/doctor.sh" ;;
  status) shift; show_status "$@" ;;
  next) shift; show_next "$@" ;;
  validate) shift; prepare_workspace_extensions; "$MEW_HOME/scripts/validate-foundation.sh" "$PWD" "$@" ;;
  context) shift; show_context "$@" ;;
  review) shift; review_stage "$@" ;;
  stack) shift; stack_command "$@" ;;
  upgrade)
    shift
    [[ $# -gt 0 && "$1" == "online" ]] || { printf 'Gunakan: mew upgrade online --prepare\n' >&2; exit 1; }
    shift
    upgrade_online "$@"
    ;;
  plugin) shift; plugin_command "$@" ;;
  automation) shift; automation_command "$@" ;;
  change) shift; change_command "$@" ;;
  feature-gap) shift; feature_gap_command "$@" ;;
  ui) shift; ui_command "$@" ;;
  template) shift; template_command "$@" ;;
  reference) shift; reference_command "$@" ;;
  runtime) shift; runtime_command "$@" ;;
  material) shift; material_command "$@" ;;
  compose) shift; compose_command "$@" ;;
  evidence) shift; evidence_command "$@" ;;
  research) shift; research_command "$@" ;;
  taxonomy) shift; taxonomy_command "$@" ;;
  operations) shift; operations_command "$@" ;;
  content) shift; content_command "$@" ;;
  tool) shift; tool_command "$@" ;;
  agent) shift; agent_command "$@" ;;
  job) shift; job_command "$@" ;;
  evaluation) shift; evaluation_command "$@" ;;
  capability) shift; capability_command "$@" ;;
  release) shift; [[ "${1:-}" == "check" && $# -eq 1 ]] || { printf 'Gunakan: mew release check\n' >&2; exit 1; }; release_check_command ;;
  approve)
    shift
    [[ "${1:-}" == "implementation" ]] || { show_help; exit 1; }
    shift
    approve_implementation "$@"
    ;;
  version) show_version ;;
  update)
    shift
    "$MEW_HOME/scripts/update.sh" "$@"
    ;;
  manifest) shift; manifest_command "$@" ;;
  package) shift; package_command "$@" ;;
  uninstall) shift; uninstall_command "$@" ;;
  help|-h|--help) show_help ;;
  *) show_help; exit 1 ;;
esac
