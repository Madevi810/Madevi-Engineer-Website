#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  LINK_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ "$SCRIPT_PATH" = /* ]] || SCRIPT_PATH="$LINK_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
MEW_HOME="$(cd "$SCRIPT_DIR/.." && pwd)"

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//; s/-$//'
}

copy_template() {
  local target="$1"
  mkdir -p "$target"
  for item in AGENTS.md FOUNDATION_MANIFEST.yaml Foundation Project-Implementasi templates docs plugins skills agent tools policies schemas evaluations README.md; do
    cp -R "$MEW_HOME/$item" "$target/"
  done
  rm -f "$target/README.md"
  cat >"$target/README.md" <<'EOF'
# MEW Workspace

This workspace was created from Madevi Engineer Website.

1. Open this folder in an AI coding environment.
2. Ask the AI to read AGENTS.md and FOUNDATION_MANIFEST.yaml.
3. Start Foundation discovery; do not add application code before approval.
EOF
}

starter_pack_source() {
  case "$1" in
    content-platform|marketplace|dashboard|hybrid-platform) printf '%s/templates/starter-packs/%s.md\n' "$MEW_HOME" "$1" ;;
    *) printf 'Starter pack tidak dikenal: %s\n' "$1" >&2; return 1 ;;
  esac
}

apply_starter_pack() {
  local target="$1" id="$2" source
  source="$(starter_pack_source "$id")" || return 1
  mkdir -p "$target/Foundation/04-Product-Modules"
  cp "$source" "$target/Foundation/04-Product-Modules/Starter-Pack-$id.md"
}

init_project() {
  local name="" template_id=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --template)
        [[ $# -ge 2 ]] || { printf 'Gunakan: mew init Name-Project --template template-id\n' >&2; exit 1; }
        template_id="$2"
        shift 2
        ;;
      *)
        [[ -z "$name" ]] || { printf 'Argumen tidak dikenal: %s\n' "$1" >&2; exit 1; }
        name="$1"
        shift
        ;;
    esac
  done
  if [[ -z "$name" ]]; then read -r -p "Name-Project: " name; fi
  [[ -n "$name" ]] || { printf 'Name-Project wajib diisi.\n' >&2; exit 1; }
  local slug target escaped
  slug="$(slugify "$name")"
  [[ -n "$slug" ]] || { printf 'Nama proyek tidak valid.\n' >&2; exit 1; }
  target="$PWD/$slug"
  [[ ! -e "$target" ]] || { printf 'Folder sudah ada: %s\n' "$target" >&2; exit 1; }
  copy_template "$target"
  if [[ -n "$template_id" ]]; then
    apply_starter_pack "$target" "$template_id"
  fi
  escaped="$(printf '%s' "$name" | sed 's/[&|]/\\&/g')"
  sed -i "s|name: Unnamed Web Project|name: $escaped|" "$target/FOUNDATION_MANIFEST.yaml"
  sed -i "s|slug: unnamed-web-project|slug: $slug|" "$target/FOUNDATION_MANIFEST.yaml"
  printf '\nWorkspace Name-Project dibuat: %s\nMasuk dengan: cd %q\nLalu jalankan: mew status\n' "$target" "$slug"
  [[ -z "$template_id" ]] || printf 'Starter pack ditambahkan: %s\n' "$template_id"
}

show_status() {
  local manifest="$PWD/FOUNDATION_MANIFEST.yaml"
  [[ -f "$manifest" ]] || { printf 'FOUNDATION_MANIFEST.yaml tidak ditemukan di folder ini.\n' >&2; exit 1; }
  if [[ "${1:-}" == "--json" ]]; then
    show_status_json "$manifest"
    return
  fi
  printf 'MEW status for %s\n\n' "$PWD"
  printf '  name: %s\n' "$(section_value project name "$manifest")"
  printf '  mode: %s\n' "$(section_value project mode "$manifest")"
  printf '  lifecycle_status: %s\n' "$(section_value project lifecycle_status "$manifest")"
  printf '  experience_level: %s\n' "$(section_value developer experience_level "$manifest")"
  printf '  guidance_mode: %s\n' "$(section_value developer guidance_mode "$manifest")"
  printf '  current_stage: %s\n' "$(section_value foundation current_stage "$manifest")"
  printf '  current_stage_name: %s\n' "$(section_value foundation current_stage_name "$manifest")"
  printf '  foundation_status: %s\n' "$(section_value foundation status "$manifest")"
  printf '  implementation_gate: %s\n' "$(section_value foundation implementation_gate "$manifest")"
  printf '  implementation_status: %s\n' "$(section_value foundation implementation_status "$manifest")"
  printf '  change_status: %s\n' "$(section_value change_management change_status "$manifest")"
  printf '  active_reference: %s\n' "$(section_value ui_ux active_reference "$manifest")"
  printf '  active_reference_name: %s\n' "$(section_value ui_ux active_reference_name "$manifest")"
  printf '  reference_analysis_file: %s\n' "$(section_value ui_ux reference_analysis_file "$manifest")"
  printf '  reference_status: %s\n' "$(section_value ui_ux reference_status "$manifest")"
  printf '  simulation_status: %s\n' "$(section_value ui_ux simulation_status "$manifest")"
  printf '  history_status: %s\n' "$(section_value implementation_history status "$manifest")"
  printf '  automation_enabled: %s\n' "$(section_value automation enabled "$manifest")"
  printf '  orchestration_status: %s\n' "$(section_value agent_orchestration status "$manifest")"
  printf '  orchestration_mode: %s\n' "$(section_value agent_orchestration mode "$manifest")"
  printf '  question_budget: %s\n' "$(section_value agent_orchestration question_budget "$manifest")"
  printf '  runtime_profile_status: %s\n' "$(section_value agent_runtime profile_status "$manifest")"
  printf '  composition_status: %s\n' "$(section_value composition status "$manifest")"
  printf '  evidence_status: %s\n' "$(section_value external_evidence status "$manifest")"
  printf '  content_operations_status: %s\n' "$(section_value content_operations status "$manifest")"
}

section_value() {
  local section="$1" key="$2" manifest="$3"
  awk -v section="$section" -v key="$key" '
    $0 == section ":" { active=1; next }
    active && /^[^[:space:]]/ { exit }
    active && $0 ~ "^  " key ":" {
      sub("^  " key ":[[:space:]]*", "")
      sub("[[:space:]]*#.*$", "")
      print
      exit
    }
  ' "$manifest"
}

set_section_value() {
  local section="$1" key="$2" new_value="$3" manifest="${4:-FOUNDATION_MANIFEST.yaml}"
  local temporary
  temporary="$(mktemp "${manifest}.tmp.XXXXXX")"
  awk -v section="$section" -v key="$key" -v value="$new_value" '
    $0 == section ":" { active=1; print; next }
    active && /^[^[:space:]]/ { active=0 }
    active && $0 ~ "^  " key ":" {
      comment = ""
      if (match($0, /[[:space:]]+#/)) comment = substr($0, RSTART)
      print "  " key ": " value comment
      changed=1
      next
    }
    { print }
    END { if (!changed) exit 3 }
  ' "$manifest" >"$temporary" || { rm -f "$temporary"; printf 'Manifest field tidak ditemukan: %s.%s\n' "$section" "$key" >&2; return 1; }
  mv "$temporary" "$manifest"
}

json_escape() {
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

show_status_json() {
  local manifest="$1"
  printf '{"schema":"mew-status/v1","workspace":"%s","project":{"name":"%s","slug":"%s","mode":"%s","lifecycle_status":"%s"},"developer":{"experience_level":"%s","guidance_mode":"%s"},"foundation":{"current_stage":"%s","current_stage_name":"%s","status":"%s","implementation_gate":"%s","implementation_status":"%s"},"change_management":{"active_request":"%s","status":"%s","last_impact_level":"%s"},"ui_ux":{"active_reference":"%s","active_reference_name":"%s","reference_analysis_file":"%s","reference_status":"%s","creative_brief_status":"%s","simulation_status":"%s","preferred_simulation":"%s"},"implementation_history":{"status":"%s","current_release":"%s"},"automation":{"enabled":"%s"},"agent_runtime":{"profile_status":"%s","web_research":"%s","github_access":"%s"},"agent_orchestration":{"status":"%s","mode":"%s","question_budget":"%s"},"composition":{"status":"%s"},"external_evidence":{"status":"%s","source_policy_status":"%s"},"content_operations":{"enabled":"%s","status":"%s","mode":"%s","scale_target":"%s","taxonomy_status":"%s","research_policy_status":"%s","publishing_status":"%s"}}\n' \
    "$(json_escape "$PWD")" \
    "$(json_escape "$(section_value project name "$manifest")")" \
    "$(json_escape "$(section_value project slug "$manifest")")" \
    "$(json_escape "$(section_value project mode "$manifest")")" \
    "$(json_escape "$(section_value project lifecycle_status "$manifest")")" \
    "$(json_escape "$(section_value developer experience_level "$manifest")")" \
    "$(json_escape "$(section_value developer guidance_mode "$manifest")")" \
    "$(json_escape "$(section_value foundation current_stage "$manifest")")" \
    "$(json_escape "$(section_value foundation current_stage_name "$manifest")")" \
    "$(json_escape "$(section_value foundation status "$manifest")")" \
    "$(json_escape "$(section_value foundation implementation_gate "$manifest")")" \
    "$(json_escape "$(section_value foundation implementation_status "$manifest")")" \
    "$(json_escape "$(section_value change_management active_request "$manifest")")" \
    "$(json_escape "$(section_value change_management change_status "$manifest")")" \
    "$(json_escape "$(section_value change_management last_impact_level "$manifest")")" \
    "$(json_escape "$(section_value ui_ux active_reference "$manifest")")" \
    "$(json_escape "$(section_value ui_ux active_reference_name "$manifest")")" \
    "$(json_escape "$(section_value ui_ux reference_analysis_file "$manifest")")" \
    "$(json_escape "$(section_value ui_ux reference_status "$manifest")")" \
    "$(json_escape "$(section_value ui_ux creative_brief_status "$manifest")")" \
    "$(json_escape "$(section_value ui_ux simulation_status "$manifest")")" \
    "$(json_escape "$(section_value ui_ux preferred_simulation "$manifest")")" \
    "$(json_escape "$(section_value implementation_history status "$manifest")")" \
    "$(json_escape "$(section_value implementation_history current_release "$manifest")")" \
    "$(json_escape "$(section_value automation enabled "$manifest")")" \
    "$(json_escape "$(section_value agent_runtime profile_status "$manifest")")" \
    "$(json_escape "$(section_value agent_runtime web_research "$manifest")")" \
    "$(json_escape "$(section_value agent_runtime github_access "$manifest")")" \
    "$(json_escape "$(section_value agent_orchestration status "$manifest")")" \
    "$(json_escape "$(section_value agent_orchestration mode "$manifest")")" \
    "$(json_escape "$(section_value agent_orchestration question_budget "$manifest")")" \
    "$(json_escape "$(section_value composition status "$manifest")")" \
    "$(json_escape "$(section_value external_evidence status "$manifest")")" \
    "$(json_escape "$(section_value external_evidence source_policy_status "$manifest")")" \
    "$(json_escape "$(section_value content_operations enabled "$manifest")")" \
    "$(json_escape "$(section_value content_operations status "$manifest")")" \
    "$(json_escape "$(section_value content_operations mode "$manifest")")" \
    "$(json_escape "$(section_value content_operations scale_target "$manifest")")" \
    "$(json_escape "$(section_value content_operations taxonomy_status "$manifest")")" \
    "$(json_escape "$(section_value content_operations research_policy_status "$manifest")")" \
